---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.redirect_to == nil" | where_exp: "p", "p.url != '/404.html'" %}
{%- for p in pages %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for s in site.case_studies %}
  <url><loc>{{ s.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
